@{
    Layout = "_Layout";
}

@model List<Company.Domain.Entities.Category>

<div class="row">

    <!-- Categories -->
    <div class="col-lg-6">

        <div class="card">

            <div class="card-body">

                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="card-title mb-0">
                        Categories
                    </h5>

                    <button type="button"
                            id="btnNewCategory"
                            class="btn btn-primary">

                        <i class="bi bi-plus-lg"></i>
                        New Category

                    </button>

                </div>


                <!-- Category Table -->

                <div style="max-height: 250px; overflow-y: auto;">

                    <table class="table table-striped">

                        <thead>

                            <tr>

                                <th scope="col">
                                    #
                                </th>

                                <th scope="col">
                                    Name
                                </th>

                                <th scope="col" class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody id="categoryTableBody">

                            @foreach (var cat in Model)
                            {
                                <tr>

                                    <th scope="row">
                                        @cat.Id
                                    </th>

                                    <td>
                                        @cat.Title
                                    </td>

                                    <td class="text-end">

                                        <button type="button"
                                                class="btn btn-sm btn-warning btn-edit-category"
                                                data-id="@cat.Id"
                                                data-name="@cat.Title">

                                            <i class="bi bi-pencil"></i>
                                            Edit

                                        </button>


                                        <button type="button"
                                                class="btn btn-sm btn-danger btn-delete-category"
                                                data-id="@cat.Id">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- Category Form -->

                <hr />

                <div>

                    <label for="categoryName"
                           class="form-label">

                        Category Name

                    </label>


                    <input type="text"
                           id="categoryName"
                           class="form-control"
                           placeholder="Enter category name"
                           maxlength="100"
                           autocomplete="off"
                           disabled />

                    <span id="categoryError"
                          class="d-block text-danger small mt-1"></span>

                    <span id="categoryMessage"
                          class="d-block text-success small mt-1"></span>


                    <!-- Category Id -->

                    <input type="hidden"
                           id="categoryId" />

                    @* Used by Categories.js to send the RequestVerificationToken header *@
                    @Html.AntiForgeryToken()


                    <div class="mt-3">

                        <button type="button"
                                id="btnSaveCategory"
                                class="btn btn-success"
                                disabled>

                            <i id="saveCategoryIcon"
                               class="bi bi-check-lg"></i>
                            <span id="saveCategoryText">Save</span>

                        </button>


                        <button type="button"
                                id="btnCancelCategory"
                                class="btn btn-secondary"
                                disabled>

                            Cancel

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Tags -->
    <div class="col-lg-6">

        <div class="card">

            <div class="card-body">

                <h5 class="card-title">
                    Tags
                </h5>

                <!-- Tags content -->

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @* Antiforgery token is rendered above the Save button, next to #categoryId *@

    @* asp-append-version appends a content-hash to the URL so browsers never
       serve a stale cached copy of this script after a deploy. *@
    <script src="~/js/BaseInfo/Categories.js" asp-append-version="true"></script>
}
