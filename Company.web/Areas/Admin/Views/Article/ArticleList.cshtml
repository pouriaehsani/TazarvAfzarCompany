@{
    Layout = "_Layout";
}
@model List<Company.Domain.Entities.Article>

<div class="card">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="card-title mb-0">
                Articles
            </h5>

            <a asp-area="Admin"
               asp-controller="Article"
               asp-action="CreateArticle"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>
                Create Article

            </a>

        </div>


        <table class="table table-striped">

            <thead>
                <tr>

                    <th scope="col">
                        #
                    </th>

                    <th scope="col">
                        Title
                    </th>

                    <th scope="col">
                        Category
                    </th>

                    <th scope="col">
                        Date Created
                    </th>

                    <th scope="col">
                        Actions
                    </th>

                </tr>
            </thead>


            <tbody>

                @foreach (var article in Model)
                {
                    <tr>

                        <th scope="row">
                            @article.Id
                        </th>

                        <td>
                            @article.Title
                        </td>

                        <td>
                            @article.Category
                        </td>

                        <td>
                            @article.CreateDate.ToString("yyyy/MM/dd")
                        </td>

                        <td>

                            <a asp-controller="Article"
                               asp-action="Edit"
                               asp-route-id="@article.Id"
                               class="btn btn-sm btn-warning">

                                <i class="bi bi-pencil"></i>
                                Edit

                            </a>


                            <a asp-controller="Article"
                               asp-action="Delete"
                               asp-route-id="@article.Id"
                               class="btn btn-sm btn-danger">

                                <i class="bi bi-trash"></i>
                                Delete

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>