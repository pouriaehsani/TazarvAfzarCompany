@{
    Layout = "_Layout";
}
@model Company.Application.DTOs.Article.CreateArticleDto

<div class="card">

    <div class="card-body">

        <h5 class="card-title">Create Article</h5>

        <form asp-area="Admin"
              asp-controller="Article"
              asp-action="CreateArticle"
              method="post"
              enctype="multipart/form-data"
              id="createArticleForm">

            <!-- Title -->
            <div class="row mb-3">

                <label asp-for="Title"
                       class="col-sm-2 col-form-label">
                    Title
                </label>

                <div class="col-sm-10">

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>

                </div>

            </div>


            <!-- Description -->
            <div class="row mb-3">

                <label asp-for="Description"
                       class="col-sm-2 col-form-label">
                    Description
                </label>

                <div class="col-sm-10">

                    <textarea asp-for="Description"
                              class="form-control"
                              style="height: 100px">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- Category -->
            <div class="row mb-3">

                <label asp-for="CategoryId"
                       class="col-sm-2 col-form-label">
                    Category
                </label>

                <div class="col-sm-10">

                    <select asp-for="CategoryId"
                            class="form-select">

                        <option value="">
                            Choose category
                        </option>

                        <option value="1">
                            One
                        </option>

                        <option value="2">
                            Two
                        </option>

                        <option value="3">
                            Three
                        </option>

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- Image -->
            <div class="row mb-3">

                <label asp-for="Image"
                       class="col-sm-2 col-form-label">
                    Image
                </label>

                <div class="col-sm-10">

                    <input asp-for="Image"
                           class="form-control"
                           type="file"
                           accept=".jpg,.jpeg,.png" />

                    <span asp-validation-for="Image"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- Tags -->
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">
                    Tags
                </label>

                <div class="col-sm-10">

                    <input type="text"
                           id="tagInput"
                           class="form-control"
                           placeholder="Type a tag and press Enter" />

                    <div id="tagValues"></div>

                    <span asp-validation-for="TagNames"
                          class="text-danger"></span>

                </div>
            </div>

            <!-- Content -->
            <div class="row mb-3">

                <label asp-for="Content"
                       class="col-sm-2 col-form-label">
                    Content
                </label>

                <div class="col-sm-10">

                    <textarea asp-for="Content"
                              id="articleContent"
                              class="form-control">
                    </textarea>

                    <span asp-validation-for="Content"
                          class="text-danger">
                    </span>

                </div>

            </div>



            <!-- Submit -->
            <div class="row mb-3">

                <div class="col-sm-10 offset-sm-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Create

                    </button>

                    <a asp-area="Admin"
                       asp-controller="Article"
                       asp-action="ArticleList"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-arrow-right"></i>
                        Back

                    </a>

                </div>

            </div>

        </form>

    </div>
</div>
    
@section Scripts
{
    <script>
        window.articleContentImageUploadUrl =
            '@Url.Action("UploadContentImage", "Article", new { area = "Admin" })';
    </script>
    <script src="~/js/article/tinymcecontent.js"></script>
    <script src="~/js/article/tags.js"></script>
}